# Copy to .env and fill in for your machine. .env is gitignored — never commit it.
DATABASE_URL=postgresql+asyncpg://YOUR_MAC_USERNAME@localhost:5432/ours_dev
SECRET_KEY=generate-with: python -c 'import secrets; print(secrets.token_hex(32))'

# Outgoing mail for confirmation links. Leave RESEND_API_KEY unset in
# development — the link is logged to the server console instead of sent, so
# nothing external is needed to work on this.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Ours <hello@yourdomain.org>
# Where confirmation links point (the deployed origin in production).
# PUBLIC_BASE_URL=http://localhost:5173

# Google sign-in. Create an OAuth 2.0 Client ID (type: Web application) in the
# Google Cloud console, and add this exact authorised redirect URI:
#   <PUBLIC_BASE_URL>/api/auth/google/callback
# Leave unset to hide the button and disable the endpoints.
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
